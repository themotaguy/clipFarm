# --- Whisper (faster-whisper / CTranslate2, runs on CPU) ---
# tiny | base | small | medium | large-v3 | distil-large-v3
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8
WHISPER_DEVICE=cpu
# Force a language (e.g. "en") or leave blank to auto-detect.
WHISPER_LANGUAGE=

# --- Ollama ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_NUM_CTX=8192

# --- clip shaping ---
CLIP_MIN_SECONDS=15
CLIP_MAX_SECONDS=180
CLIP_TARGET_SECONDS=45
MAX_CLIPS=5
# How many retrieved candidates get sent to the LLM for scoring.
SCORE_CANDIDATES=14
# Spread selected clips across the whole length range rather than letting them
# cluster near the target duration.
DURATION_SPREAD=true
# Retrieval windows stay short whatever CLIP_MAX_SECONDS says.
WINDOW_MAX_SECONDS=90

# --- sponsor / ad segments ---
# Integrated ads make tempting clips and worthless ones. Detected reads are
# excluded from candidate selection.
AD_DETECTION=true
# Discard a candidate with at least this fraction inside an ad.
AD_OVERLAP_THRESHOLD=0.25
# How far apart two brand mentions can be and still count as one read.
AD_GAP_SECONDS=30
AD_MIN_SECONDS=6

# Cut subscribe/like asks out of clips too, stitching the halves together.
FILLER_DETECTION=true

# --- narrative shape ---
# The scorer names the most scroll-stopping sentence but routinely starts the
# clip well before it. These re-anchor the clip onto the hook.
HOOK_ANCHOR=true
HOOK_RUN_UP_SECONDS=1.0
# How much preamble may be skipped to reach the hook. The larger cap applies
# only when the hook was matched near-verbatim.
HOOK_TRIM_MAX_SECONDS=15
HOOK_TRIM_STRONG_SECONDS=45
HOOK_STRONG_MATCH=0.85
HOOK_MATCH_THRESHOLD=0.6

# Never end on a buildup whose payoff lands just after the cut.
REVEAL_COMPLETION=true
REVEAL_WINDOW_SECONDS=25

# Review the finalists with a second LLM call. Advisory only: suggestions must
# clear the same deterministic gates before they are adopted.
CRITIC_PASS=true

# --- topic completion ---
# Let a clip run on past a full stop to finish the thought it started.
TOPIC_COMPLETION=true
TOPIC_EXTEND_SECONDS=45
TOPIC_SHIFT_THRESHOLD=0.62

# --- cut points ---
# Cuts land on word edges by default, which sounds severed. These let a
# boundary move to nearby silence and leave a little breathing room.
CLIP_LEAD_IN_SECONDS=0.25
CLIP_TAIL_SECONDS=0.6
# How far (seconds) a cut may travel to reach a pause or sentence break.
# Asymmetric: reaching forward to let a sentence finish is cheap, cutting
# backwards discards a moment the scorer chose on purpose.
CLIP_SNAP_EXTEND=10.0
CLIP_SNAP_TRUNCATE=1.5
# Shortest gap that counts as a pause.
CLIP_MIN_PAUSE=0.18

# --- stitching ---
# Let a clip prepend one earlier "setup" passage when its opening refers to
# something it never explains ("the third move", "that number", ...).
STITCH_SETUP=true
SETUP_MAX_SECONDS=20
# How much transcript either side of a candidate the scorer may draw setup from.
SETUP_CONTEXT_SECONDS=60

# --- render ---
# How a landscape source is fitted to the vertical canvas:
#   crop - fill the frame, tracking the main subject (default)
#   blur - letterbox over a blurred copy of the frame
#   auto - crop when a subject is found, else blur
RENDER_FILL=crop
FRAMING_SAMPLES=12
# Re-frame on every cut rather than using one crop for the whole clip.
FRAMING_PER_SHOT=true
# Within a shot holding two or more faces, follow whoever is speaking.
# Needs opencv-python-headless plus a one-off ~230 KB model download.
SPEAKER_TRACKING=true

RENDER_WIDTH=1080
RENDER_HEIGHT=1920
BURN_CAPTIONS=true
# auto | libass | pillow | none
#   auto   - use ffmpeg's libass if present, else draw captions with Pillow
#   libass - require ffmpeg's subtitles filter
#   pillow - always draw them ourselves (works with any ffmpeg build)
CAPTION_RENDERER=auto
CAPTION_FONT=Arial Black

# Pin a specific ffmpeg. Left blank, clipFarm searches PATH and prefers a
# libass-capable build (e.g. Homebrew's keg-only ffmpeg-full) when the one on
# PATH cannot burn captions.
FFMPEG_BINARY=
FFPROBE_BINARY=

# --- server ---
FLASK_HOST=127.0.0.1
FLASK_PORT=5001
MAX_UPLOAD_MB=2048
