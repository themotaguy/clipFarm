# --- Whisper (faster-whisper / CTranslate2, runs on CPU) ---
# tiny | base | small | medium | large-v3 | distil-large-v3
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8
WHISPER_DEVICE=cpu
# Force a language (e.g. "en") or leave blank to auto-detect.
WHISPER_LANGUAGE=

# --- Ollama ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_NUM_CTX=8192

# --- clip shaping ---
CLIP_MIN_SECONDS=18
CLIP_MAX_SECONDS=75
CLIP_TARGET_SECONDS=45
MAX_CLIPS=5
# How many retrieved candidates get sent to the LLM for scoring.
SCORE_CANDIDATES=14

# --- render ---
RENDER_WIDTH=1080
RENDER_HEIGHT=1920
BURN_CAPTIONS=true

# --- server ---
FLASK_HOST=127.0.0.1
FLASK_PORT=5001
MAX_UPLOAD_MB=2048
